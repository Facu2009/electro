# Variables de entorno del backend.
# Copia este archivo como ".env" y completa con tus valores reales.

# Ruta del archivo JSON de la cuenta de servicio de Firebase.
# Por defecto busca "firebase_service_account.json" en la raíz del backend.
# FIREBASE_SERVICE_ACCOUNT=C:/ruta/al/firebase_service_account.json

# Orígenes permitidos para CORS (separados por coma).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
