# Variables de entorno del frontend (React).
# Copia este archivo como ".env" y completa con los valores de tu
# proyecto Firebase. Los obtienes en: Firebase Console -> Configuración
# del proyecto -> "Tus apps" -> App web.

REACT_APP_FIREBASE_API_KEY=TU_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=TU_PROYECTO.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=TU_PROYECTO_ID
REACT_APP_FIREBASE_STORAGE_BUCKET=TU_PROYECTO.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=TU_SENDER_ID
REACT_APP_FIREBASE_APP_ID=TU_APP_ID

# URL del backend Flask (base para las peticiones a la API).
REACT_APP_API_URL=http://localhost:5000
